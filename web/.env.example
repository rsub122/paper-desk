# Daytona (sandboxes). Without it, runs fall back to local Python (no isolation, dev only).
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=paper-desk
PAPERDESK_SANDBOXES=10
# Claude: plain English -> strategy, honest variants, "why" answer
# Only for org-level keys that are not scoped to a workspace (console.anthropic.com > Workspaces)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
PAPERDESK_MODEL=claude-sonnet-5-5
# Locked period starts here: set to the model's training cutoff
PAPERDESK_LOCK_DATE=2026-01-01
# Arize AX tracing (app.arize.com → Space settings → API keys)
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=paper-desk
# Alpaca PAPER account (seal places one paper order; also used by engine/fetch_prices.py)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
